DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
TWELVEDATA_API_KEYS=<twelve-data-api-key-2>,<twelve-data-api-key-3>
TWELVEDATA_REST_BASE_URL=https://api.twelvedata.com
CRAWL_PROXY_URL=http://<user>:<password>@<residential-proxy-host>:<port>
PROVIDER_HTTP_TIMEOUT_SECONDS=5
PROVIDER_WS_RECONNECT_DELAY_SECONDS=5
QUOTE_CACHE_TTL_SECONDS=10
QUOTE_STALE_AFTER_SECONDS=30
MAX_QUOTE_SYMBOLS=10
MAX_CANDLES_PER_REQUEST=1000
MAX_CANDLE_COUNT_SCAN_SLOTS=10000
CANDLE_FORMING_CACHE_TTL_SECONDS=5
STREAM_CLIENT_QUEUE_CAPACITY=256
STREAM_PROVIDER_QUEUE_CAPACITY=1024
STREAM_IDLE_GRACE_SECONDS=5
STREAM_FRESHNESS_CHECK_SECONDS=1
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<test_database>

# Container builds bake SOURCE_REVISION into the image; do not override it here.

# MT5 quote and calendar feeds.
# Set to 0 for database-only operation without a provisioned MT5 terminal/token.
# One worker; TCP must stay on a private network.
ECONOMIC_CALENDAR_POLL_SECONDS=300
MT5_ENABLED=false
MT5_TCP_HOST=0.0.0.0
MT5_TCP_PORT=9001
MT5_CALENDAR_TCP_PORT=9002
MT5_CALENDAR_TIMEOUT_SECONDS=60
# MT5_TOKEN_FILE=/run/secrets/mt5-token
MT5_REQUEST_TIMEOUT_SECONDS=15
