# Copy to .env and fill in runtime credentials; never commit the populated file.
# Image-only startup requires these images to be available locally or in your registry.
MDG_IMAGE=signapse-mdg:mt5-compose-local
MT5_IMAGE=signapse-mt5:cpu-lean-local

# Use a long random value containing only letters, digits, _ or - (embedded in a URI).
POSTGRES_PASSWORD=replace_with_a_long_random_URL_safe_password

MT5_LOGIN=replace_with_your_demo_login
MT5_PASSWORD='replace_with_your_demo_password'
MT5_SERVER=VantageMarkets-Demo
# Use the same private random token for the gateway and terminal; minimum 32 characters.
MT5_TOKEN=replace_with_a_private_random_token_at_least_32_characters

MDG_HTTP_PORT=18081
ECONOMIC_CALENDAR_POLL_SECONDS=300
MT5_CALENDAR_TIMEOUT_SECONDS=60
# Optional: provider symbols must agree with the 20 mappings seeded by this bundle.
# MT5_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,XAUUSD,XAGUSD,AAPL,TSLA,NVIDIA,MSFT,SPY,QQQ,USOUSD,UKOUSD,NG-Cr,Coffee-Cr,Sugar-Cr,Wheat-Cr,SP500.r,NAS100.r
